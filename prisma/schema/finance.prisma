// Finance tool.
//
// Money is stored as integer minor units (cents for USD). The display layer
// divides by 100. Never use Float for money. Sign convention: negative amount
// = debit/outflow, positive = credit/inflow.

model FinanceConnection {
  id                String           @id @default(cuid())
  userId            String
  provider          String
  enrollmentId      String
  institutionId     String?
  institutionName   String?
  accessTokenEnc    String
  status            String           @default("active")
  lastSyncedAt      DateTime?
  lastSyncError     String?
  disconnectedReason String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts          FinanceAccount[]

  @@unique([userId, provider, enrollmentId])
  @@index([userId, status])
}

model FinanceAccount {
  id                    String   @id @default(cuid())
  userId                String
  connectionId          String?
  externalId            String?
  syncSource            String   @default("manual")
  name                  String
  kind                  String
  currency              String   @default("USD")
  includeInNetWorth     Boolean  @default(true)
  includeInCashPosition Boolean  @default(false)
  currentBalanceCents   Int
  balanceUpdatedAt      DateTime
  statementBalanceCents Int?
  dueDate               DateTime?
  creditLimitCents      Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection            FinanceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  transactions          FinanceTransaction[]
  balanceSnapshots      FinanceBalanceSnapshot[]
  statementChecks       FinanceStatementCheck[]
  plan                  FinanceAccountPlan?

  @@index([userId, kind])
  @@index([connectionId])
  @@unique([userId, externalId])
  @@unique([userId, name])
}

model FinanceGoal {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  owner              String   @default("shared")
  category           String   @default("general")
  targetAmountCents  Int
  currentAmountCents Int      @default(0)
  targetDate         DateTime?
  monthlyContributionCents Int?
  status             String   @default("active")
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@unique([userId, name])
}

model FinanceTransaction {
  id                    String   @id @default(cuid())
  userId                String
  financeAccountId      String?
  externalId            String?
  syncSource            String   @default("manual")
  postedStatus          String?
  providerCategory      String?
  date                  DateTime
  amount                Int
  currency              String   @default("USD")
  description           String
  account               String?
  category              String?
  raw                   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  financeAccount        FinanceAccount? @relation(fields: [financeAccountId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([financeAccountId, date])
  @@unique([userId, externalId])
}

// Monthly spend limit for one category. Scope userId is the household data
// user once a household exists (or the person's own id for "Just me").
model FinanceBudget {
  id                String   @id @default(cuid())
  userId            String
  category          String
  monthlyLimitCents Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

// Recurring bill or renewal (rent, insurance, car registration). nextDueAt
// advances by cadence when marked paid.
model FinanceBill {
  id             String    @id @default(cuid())
  userId         String
  name           String
  amountCents    Int?
  cadence        String    @default("monthly") // "weekly" | "monthly" | "quarterly" | "yearly" | "once"
  nextDueAt      DateTime
  category       String?
  autopay        Boolean   @default(false)
  notes          String?
  lastPaidAt     DateTime?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, archivedAt, nextDueAt])
}

// Dated balance of one account, recorded on every balance update and every
// finished statement check. Net worth history is rebuilt from these.
// Balance is in the account's own terms (owed, for cards and loans).
model FinanceBalanceSnapshot {
  id               String         @id @default(cuid())
  userId           String
  financeAccountId String
  balanceCents     Int
  asOf             DateTime
  source           String         @default("manual") // "manual" | "statement"
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account          FinanceAccount @relation(fields: [financeAccountId], references: [id], onDelete: Cascade)

  @@index([userId, asOf])
  @@index([financeAccountId, asOf])
}

// A finished statement check ("reconcile"): the statement's period and
// balances, and what it took to make them match.
model FinanceStatementCheck {
  id                    String         @id @default(cuid())
  userId                String
  financeAccountId      String
  periodStart           DateTime
  periodEnd             DateTime
  openingBalanceCents   Int
  closingBalanceCents   Int
  adjustmentCents       Int            @default(0)
  matchedCount          Int            @default(0)
  addedCount            Int            @default(0)
  checkedByUserId       String?
  createdAt             DateTime       @default(now())
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               FinanceAccount @relation(fields: [financeAccountId], references: [id], onDelete: Cascade)

  @@index([financeAccountId, periodEnd])
  @@index([userId, createdAt])
}

// Projection settings for one account: how much goes in (or gets paid off)
// each month, and the yearly growth (or interest) rate in basis points.
model FinanceAccountPlan {
  financeAccountId         String         @id
  userId                   String
  monthlyContributionCents Int            @default(0)
  annualGrowthBps          Int            @default(0)
  updatedAt                DateTime       @updatedAt
  user                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                  FinanceAccount @relation(fields: [financeAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Remembered shop rule: a shop's key (see src/lib/finance-shop-rules.ts) maps
// to the name and category its entries get. userId is the finance scope
// (household data user or the person's own id); ownerUserId is the person
// who made it, so each person keeps their own categories.
// Created by scripts/create-finance-shop-rules.sql.
model FinanceShopRule {
  id          String   @id @default(cuid())
  userId      String
  ownerUserId String
  match       String
  name        String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ownerUserId, match])
  @@index([userId])
}
