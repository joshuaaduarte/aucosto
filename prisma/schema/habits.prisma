model Habit {
  id                     String      @id @default(cuid())
  userId                 String
  title                  String
  bucket                 String?
  notes                  String?
  fallbackTitle          String?
  rescuePrompt           String?
  dayPart                String      @default("anytime")
  cadence                String      @default("daily")
  daysOfWeek             String?
  targetCount            Int         @default(1)
  goalUnit               String      @default("check")
  defaultDurationMinutes Int?
  reminderTime           String?
  windowStart            String?
  windowEnd              String?
  archivedAt             DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries                HabitEntry[]
  doItems                DoItem[]
  timeEntries            TimeEntry[]

  @@index([userId, archivedAt, updatedAt])
  @@index([userId, cadence, updatedAt])
  @@index([userId, bucket, updatedAt])
}

model HabitEntry {
  id        String   @id @default(cuid())
  userId    String
  habitId   String
  mode      String   @default("full")
  quantity  Int      @default(1)
  notes     String?
  loggedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@index([habitId, loggedAt])
}

// Per-habit settings kept out of Habit so existing queries never depend on
// it (accessed with raw SQL in services/habits/preferences.ts; created by
// scripts/create-habit-preferences.sql). No Prisma relation on purpose.
model HabitPreference {
  habitId      String   @id
  userId       String
  healthMetric String?
  focus        String?
  cue          String?
  updatedAt    DateTime @default(now())

  @@index([userId])
}
